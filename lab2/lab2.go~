// main creates a gorilla/mux router that handles three routes described in the
// introduction
func main() {
	router := mux.NewRouter()

	router.Path("/api/v1/vars/{id:[0-9]}").Methods("GET").HandlerFunc(handleGetVar)
	router.Path("/api/v1/vars/{id:[0-9]}").Methods("POST").HandlerFunc(handlePostVar)
	router.Path("/api/v1/vars/{id:[0-9]}").Methods("DELETE").HandlerFunc(handleDeleteVar)

	panic(http.ListenAndServe(":8080", router))
}

