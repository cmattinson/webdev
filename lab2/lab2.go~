// For this lab, use gorilla/mux to implement the following three routes:
//
// (1) GET requests to /api/v1/var/n cause a lookup of n in the "vars" map,
//     and if the string has a length greater than 0, the server prints
//     the corresponding string to the ResponseWriter.
//
//     String with a positive length: 200 (OK)
//     String with a length of zero:  204 (No Content)
//     A bad request:                 400 (Bad Request)
//
// (2) DELETE requests to /api/v1/var/n cause a lookup of n in the "vars"
//     map, and if the string has a length greater than 0, the server sets
//     the string to the empty string and returns 204. If the length is
//     already 0, it returns 400 (Bad request).
//
//     On success: 204 (No Content)
//     On failure: 400 (Bad Request)
//
// (3) POST requests to /api/v1/var/n cause the server to set the string
//     at position n to the string provided in the non-0 length body of the
//     request. On success, it returns the string the response.
//
//     On success: 200 (OK)
//     On failure: 400 (Bad Request)
//
// All other routes may generate a 404 (Not Found).

package main

import (
	"fmt"
	"net/http"
	"sync"

	"github.com/gorilla/mux"
)

// mutex exists to ensure safe access to the map "shared"
