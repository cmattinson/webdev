# -*- restclient -*-
#
# Tests authorization to API
GET http://localhost:8080/api/v1
Authorization: Bearer jqYPeRSj

# Test authorization with unauthorized user
GET http://localhost:8080/api/v1
Authorization: Bearer notAuthorized

# Test authorization with no bearer token
GET http://localhost:8080/api/v1

# Gets the list of presenters
GET http://localhost:8080/api/v1/presenters
Authorization: Bearer jqYPeRSj

# Gets the list of presenters in XML
GET http://localhost:8080/api/v1/presenters.xml
Authorization: Bearer jqYPeRSj

# Gets the list of presenters
GET http://localhost:8080/api/v1/presenters.json
Authorization: Bearer jqYPeRSj

# Gets presentation info for a presenter (Survey form, JSON default)
GET http://localhost:8080/api/v1/presenters/1
Authorization: Bearer jqYPeRSj

# Gets presentation info in JSON
GET http://localhost:8080/api/v1/presenters/1.json
Authorization: Bearer jqYPeRSj

# Gets presentation info in XML
GET http://localhost:8080/api/v1/presenters/1.xml
Authorization: Bearer jqYPeRSj

# Sends a response to a question as the authenticated user
POST http://localhost:8080/api/v1/presenters/1
Authorization: Bearer jqYPeRSj
Content-Type: application/json

{
	"type": "M/C",
	"number": 1,
	"answer": "Neutral"
}

# Update the response above
PUT http://localhost:8080/api/v1/presenters/1
Authorization: Bearer jqYPeRSj
Content-Type: application/json

{
	"type": "M/C",
	"number": 1,
	"answer": "Agree"
}

# Send another response to a question as authenticated user
POST http://localhost:8080/api/v1/presenters/1
Authorization: Bearer jqYPeRSj
Content-Type: application/json

{
	"type": "M/C",
	"number": 2,
	"answer": "Disagree"
}

# Send another response to a question as authenticated user
POST http://localhost:8080/api/v1/presenters/1
Authorization: Bearer jqYPeRSj
Content-Type: application/json

{
	"type": "M/C",
	"number": 3,
	"answer": "Strongly Disagree"
}

# Send an Open question response
POST http://localhost:8080/api/v1/presenters/1
Authorization: Bearer jqYPeRSj
Content-Type: application/json

{
	"type": "Open",
	"number": 1,
	"answer": "Presentation was interesting"
}

# Get the list of responses to the presenter
GET http://localhost:8080/api/v1/responses/1
Authorization: Bearer jqYPeRSj

# Get the list of responses to the presenter
GET http://localhost:8080/api/v1/responses/1.json
Authorization: Bearer jqYPeRSj

# Get the list of responses to the presenter
GET http://localhost:8080/api/v1/responses/1.xml
Authorization: Bearer jqYPeRSj

# Delete the response for Multiple Choice 1
DELETE http://localhost:8080/api/v1/responses/1
Authorization: Bearer jqYPeRSj
Content-Type: application/json

{
	"type": "M/C",
	"number": 1
}

# Attempt to delete a response that doesn't exist
DELETE http://localhost:8080/api/v1/responses/1
Authorization: Bearer jqYPeRSj
Content-Type: application/json

{
	"type": "Open",
	"number": 5
}
	